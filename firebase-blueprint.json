{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "Barbershop services offered to clients",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "durationMinutes": { "type": "number" },
        "price": { "type": "number" },
        "icon": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "durationMinutes", "price"]
    },
    "Barber": {
      "title": "Barber",
      "description": "Barbers working at the shop",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "specialty": { "type": "string", "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 500 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 20 },
        "active": { "type": "boolean" }
      },
      "required": ["name", "active"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled appointments for haircut/beard services",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 100 },
        "clientEmail": { "type": "string", "maxLength": 100 },
        "clientPhone": { "type": "string", "maxLength": 20 },
        "barberId": { "type": "string", "maxLength": 128 },
        "barberName": { "type": "string", "maxLength": 100 },
        "serviceId": { "type": "string", "maxLength": 128 },
        "serviceName": { "type": "string", "maxLength": 100 },
        "servicePrice": { "type": "number" },
        "serviceDuration": { "type": "number" },
        "date": { "type": "string", "maxLength": 10 },
        "time": { "type": "string", "maxLength": 5 },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["clientId", "barberId", "serviceId", "date", "time", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile details",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["client", "admin"] },
        "phone": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Catalog of services"
    },
    "/barbers/{barberId}": {
      "schema": { "$ref": "#/entities/Barber" },
      "description": "Barbers staff"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Bookings created by clients"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User accounts"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "System notifications for users and staff"
    },
    "/email_outbox/{emailId}": {
      "schema": { "type": "object" },
      "description": "Outbox log for automated email notifications"
    }
  }
}
